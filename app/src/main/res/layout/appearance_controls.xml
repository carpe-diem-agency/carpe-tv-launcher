<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/appearance_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/appearance_design" android:textSize="24sp" android:textColor="#FFFFFF"/>
    <TextView android:id="@+id/wallpaper_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/cd_text_secondary" android:textSize="14sp"/>
    <HorizontalScrollView android:id="@+id/wallpaper_scroll" android:focusable="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:scrollbars="none" android:clipToPadding="false">
        <LinearLayout android:id="@+id/wallpaper_choices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp"/>
    </HorizontalScrollView>
    <Switch android:id="@+id/dynamic_wallpapers" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="16dp" android:background="@drawable/control_background" android:padding="16dp" android:thumbTint="#FFFFFF" android:trackTint="#288BFF" android:text="@string/dynamic_wallpapers" android:textColor="#FFFFFF" android:textSize="14sp" android:nextFocusDown="@id/wallpaper_dim"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/control_background">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/dim_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:labelFor="@id/wallpaper_dim"/>
            <TextView android:id="@+id/dim_value" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16sp"/>
        </LinearLayout>
        <SeekBar android:id="@+id/wallpaper_dim" android:nextFocusUp="@id/dynamic_wallpapers" android:nextFocusDown="@id/dim_reset" android:layout_width="match_parent" android:layout_height="48dp" android:max="85" android:progressTint="#288BFF" android:thumbTint="#FFFFFF" android:progressBackgroundTint="#506A87A6" android:contentDescription="@string/wallpaper_dim"/>
        <Button android:id="@+id/dim_reset" android:layout_width="wrap_content" android:minWidth="100dp" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:nextFocusUp="@id/wallpaper_dim" android:nextFocusDown="@id/animations" android:background="@drawable/control_background" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:textAllCaps="false" android:text="@string/dim_reset" android:textSize="13sp" android:textColor="@color/cd_text_secondary"/>
    </LinearLayout>
    <TextView android:id="@+id/interface_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/appearance_interface" android:textSize="24sp" android:textColor="#FFFFFF"/>
    <Switch android:id="@+id/animations" android:nextFocusUp="@id/dim_reset" android:nextFocusDown="@id/language_choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:background="@drawable/control_background" android:padding="16dp" android:thumbTint="#FFFFFF" android:trackTint="#288BFF" android:text="@string/animations" android:textColor="#FFFFFF" android:textSize="16sp"/>
    <Button android:id="@id/language_choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:nextFocusUp="@id/animations" android:nextFocusDown="@id/ui_sounds_enabled" android:background="@drawable/control_background" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textSize="16sp" android:textColor="#FFFFFF"/>
    <TextView android:id="@+id/sounds_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/appearance_sounds" android:textSize="24sp" android:textColor="#FFFFFF"/>
    <Switch android:id="@+id/ui_sounds_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:background="@drawable/control_background" android:padding="16dp" android:thumbTint="#FFFFFF" android:trackTint="#288BFF" android:text="@string/ui_sounds_enabled" android:textColor="#FFFFFF" android:textSize="16sp" android:nextFocusUp="@id/language_choice" android:nextFocusDown="@id/ui_sounds_volume"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/control_background">
        <TextView android:id="@+id/ui_sounds_label" android:layout_width="140dp" android:layout_height="wrap_content" android:text="@string/ui_sounds_volume" android:textColor="#FFFFFF" android:textSize="16sp" android:labelFor="@id/ui_sounds_volume"/>
        <SeekBar android:id="@+id/ui_sounds_volume" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:max="100" android:progressTint="#288BFF" android:thumbTint="#FFFFFF" android:progressBackgroundTint="#506A87A6" android:contentDescription="@string/ui_sounds_volume" android:nextFocusUp="@id/ui_sounds_enabled" android:nextFocusDown="@id/ui_sounds_preview"/>
        <TextView android:id="@+id/ui_sounds_value" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16sp"/>
    </LinearLayout>
    <Button android:id="@+id/ui_sounds_preview" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/control_background" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:text="@string/ui_sounds_preview" android:textSize="14sp" android:textColor="@color/cd_text_secondary" android:nextFocusUp="@id/ui_sounds_volume" android:nextFocusDown="@id/ui_sounds_preview"/>
</LinearLayout>
