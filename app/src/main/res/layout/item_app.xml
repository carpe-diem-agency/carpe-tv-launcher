<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="124dp" android:orientation="vertical" android:gravity="center" android:paddingLeft="3dp" android:paddingRight="3dp" android:focusable="true" android:clickable="true">
