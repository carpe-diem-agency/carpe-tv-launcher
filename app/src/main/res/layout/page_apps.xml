<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="24dp">
<TextView android:id="@+id/apps_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="@dimen/cd_content_inset" android:includeFontPadding="false" android:text="@string/all_apps" android:textSize="@dimen/cd_heading_size" android:textColor="@color/cd_text"/>
<EditText android:id="@+id/apps_search" android:layout_width="240dp" android:layout_height="36dp" android:singleLine="true" android:hint="@string/search" android:textColor="@color/cd_text" android:textColorHint="#E3E5ED" android:textSize="16sp" android:background="@drawable/search_background" android:paddingStart="14dp" android:paddingEnd="14dp" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:inputType="text" android:imeOptions="actionDone"/>
<ImageButton android:id="@+id/apps_power" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="8dp" android:padding="10dp" android:src="@drawable/ic_power" android:background="@drawable/nav_background" android:contentDescription="@string/sleep_now"/><ImageButton android:id="@+id/apps_wifi" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="20dp" android:padding="10dp" android:src="@drawable/ic_wifi" android:background="@drawable/nav_background" android:contentDescription="@string/wifi"/><ImageButton android:id="@+id/apps_bluetooth" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:padding="10dp" android:src="@drawable/ic_bluetooth" android:background="@drawable/nav_background" android:contentDescription="@string/bluetooth"/>
<TextView android:id="@+id/apps_timer" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:fontFamily="monospace" android:textSize="14sp" android:textColor="@color/cd_text" android:drawableStart="@drawable/ic_sleep_timer" android:background="@drawable/nav_background" android:focusable="true" android:clickable="true" android:contentDescription="@string/sleep_timer"/>
<TextClock android:id="@+id/apps_clock" android:layout_width="64dp" android:layout_height="44dp" android:gravity="end|center_vertical" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="18sp"/>
</LinearLayout>
<ScrollView android:id="@+id/apps_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="8dp" android:focusable="false"><LinearLayout android:id="@+id/apps_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
</LinearLayout>
