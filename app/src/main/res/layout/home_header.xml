<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/cd_content_inset" android:paddingTop="16dp" android:paddingBottom="32dp">
<TextClock android:id="@+id/home_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="64sp"/>
<TextClock android:id="@+id/home_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="EEEE, d MMMM" android:format12Hour="EEEE, d MMMM" android:textColor="#D8E1EF" android:textSize="18sp"/>
<TextView android:id="@+id/home_greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/greeting_evening" android:textColor="#FFFFFF" android:textSize="24sp"/>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="top|end" android:orientation="horizontal"><ImageButton android:id="@+id/home_sleep_timer" android:nextFocusLeft="@id/nav_home" android:nextFocusRight="@id/home_wifi" android:nextFocusUp="@id/home_sleep_timer" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="8dp" android:padding="10dp" android:src="@drawable/ic_power" android:background="@drawable/nav_background" android:contentDescription="@string/sleep_now"/><ImageButton android:id="@+id/home_wifi" android:nextFocusUp="@id/home_wifi" android:nextFocusDown="@id/nav_home" android:nextFocusLeft="@id/home_sleep_timer" android:nextFocusRight="@id/home_bluetooth" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_wifi" android:background="@drawable/nav_background" android:contentDescription="@string/wifi"/><ImageButton android:id="@+id/home_bluetooth" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:padding="10dp" android:src="@drawable/ic_bluetooth" android:background="@drawable/nav_background" android:contentDescription="@string/bluetooth" android:nextFocusLeft="@id/home_wifi" android:nextFocusRight="@id/home_bluetooth" android:nextFocusUp="@id/home_bluetooth"/></LinearLayout></FrameLayout>