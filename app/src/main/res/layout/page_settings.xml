<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="@dimen/cd_content_inset">
<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/cd_header_height" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/settings_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/settings" android:textColor="#FFFFFF" android:textSize="@dimen/cd_heading_size"/><ImageButton android:id="@+id/settings_power" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="8dp" android:padding="10dp" android:src="@drawable/ic_power" android:background="@drawable/nav_background" android:contentDescription="@string/sleep_now"/><ImageButton android:id="@+id/settings_wifi" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_wifi" android:background="@drawable/nav_background" android:contentDescription="@string/wifi"/><ImageButton android:id="@+id/settings_bluetooth" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:padding="10dp" android:src="@drawable/ic_bluetooth" android:background="@drawable/nav_background" android:contentDescription="@string/bluetooth"/><TextView android:id="@+id/settings_timer" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="44dp" android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center" android:fontFamily="monospace" android:textSize="14sp" android:textColor="@color/cd_text" android:drawableStart="@drawable/ic_sleep_timer" android:background="@drawable/nav_background" android:focusable="true" android:clickable="true" android:contentDescription="@string/sleep_timer"/><TextClock android:id="@+id/settings_clock" android:layout_width="64dp" android:layout_height="44dp" android:gravity="end|center_vertical" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="18sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="24dp" android:baselineAligned="false">
<LinearLayout android:id="@+id/settings_categories" android:layout_width="220dp" android:layout_height="match_parent" android:orientation="vertical"/>
<ScrollView android:id="@+id/settings_scroll" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="28dp" android:focusable="false"><LinearLayout android:id="@+id/settings_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp"/></ScrollView>
</LinearLayout></LinearLayout>
