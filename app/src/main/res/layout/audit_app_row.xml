<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="52dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="10dp" android:paddingBottom="10dp"
    android:focusable="true" android:clickable="true"
    android:background="@drawable/control_background">
    <TextView android:id="@+id/audit_app_name" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" android:textSize="14sp"
        android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF"
        android:importantForAccessibility="no"/>
    <TextView android:id="@+id/audit_app_state" android:layout_width="112dp"
        android:layout_height="wrap_content" android:gravity="end|center_vertical"
        android:textSize="12sp" android:maxLines="2" android:textColor="#B9C7DC"
        android:importantForAccessibility="no"/>
</LinearLayout>
