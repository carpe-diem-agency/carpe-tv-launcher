<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/appearance_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/appearance" android:textSize="24sp" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/wallpaper_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#B9C7DC" android:textSize="14sp"/>
<HorizontalScrollView android:id="@+id/wallpaper_scroll" android:focusable="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:scrollbars="none" android:clipToPadding="false"><LinearLayout android:id="@+id/wallpaper_choices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp"/></HorizontalScrollView>
<Switch android:id="@+id/dynamic_wallpapers" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/control_background" android:padding="16dp" android:thumbTint="#FFFFFF" android:trackTint="#288BFF" android:text="@string/dynamic_wallpapers" android:textColor="#FFFFFF" android:textSize="14sp" android:nextFocusDown="@id/wallpaper_dim"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/control_background"><TextView android:id="@+id/dim_label" android:layout_width="180dp" android:singleLine="true" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp"/>
<SeekBar android:id="@+id/wallpaper_dim" android:nextFocusDown="@id/dim_reset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:max="85" android:progressTint="#288BFF" android:thumbTint="#FFFFFF" android:progressBackgroundTint="#506A87A6"/><TextView android:id="@+id/dim_value" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="16sp"/>
</LinearLayout><Button android:id="@+id/dim_reset" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:nextFocusUp="@id/wallpaper_dim" android:nextFocusDown="@id/animations" android:background="@drawable/control_background" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:textSize="14sp" android:textColor="#B9C7DC"/><Switch android:layout_marginTop="16dp" android:id="@+id/animations" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/control_background" android:padding="16dp" android:thumbTint="#FFFFFF" android:trackTint="#288BFF" android:text="@string/animations" android:textColor="#FFFFFF" android:textSize="16sp"/>
</LinearLayout>
